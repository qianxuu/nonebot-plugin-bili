# 可选：NapCat 容器内缓存目录映射
BILI_NAPCAT_CACHE_DIR=/app/.config/QQ/NapCat/temp

# 可选：群黑名单（JSON 数组）
BILI_GROUP_BLACKLIST=["123456789", "987654321"]

# 可选：视频大小上限（MiB）
BILI_MAX_VIDEO_SIZE_MIB=50

# 可选：同群同 BV 冷却秒数
BILI_GROUP_CD_SECONDS=60

# 可选：本地缓存保留小时数
BILI_CACHE_RETENTION_HOURS=24

# 可选：直播状态轮询间隔（秒）
BILI_LIVE_POLL_INTERVAL=15
